# Copy this file to .env for local development.
# All values shown are the built-in defaults — override only what differs.

# HTTP
TIME_OUT_DURATION=15
MAXIMUM_ALLOWED_SIZE=2000000
USER_AGENT=my-crawler/0.1

# Rate limiting
REQ_PER_SECOND=1

# Redis (rate limiter)
REDIS_URL=redis://127.0.0.1:6379

# AWS
AWS_REGION=ap-south-1
S3_BUCKET=webcrawler-yash-test

# SQS queue URLs — replace 885232248981 with your account ID
FRONTIER_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/885232248981/crawler-frontier
PARSING_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/885232248981/crawler-parsing
FRONTIER_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/885232248981/crawler-frontier-dlq
